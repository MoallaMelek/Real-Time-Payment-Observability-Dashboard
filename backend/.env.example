APP_NAME="Tableau de bord de supervision"
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MOCK_ENGINE_ENABLED=true

DATA_SOURCE=mock
SQLSERVER_HOST=.
SQLSERVER_TRUST_CERTIFICATE=yes
SQLSERVER_ENCRYPT=yes
SQLSERVER_DATABASE=portfolio_demo
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
SQLSERVER_AUTH=windows

REPLAY_BATCH_SIZE=100
REPLAY_INTERVAL_SECONDS=0.5
FAST_FORWARD_BATCH_SIZE=250
FAST_FORWARD_FETCH_BATCH_SIZE=5000
FAST_FORWARD_INTERVAL_SECONDS=0.1
FRAUD_TIMEOUT_THRESHOLD_MS=5000
AMOUNT_SCALE=1000
AMOUNT_UNIT=TND

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///./data/payments.db
WEBSOCKET_AUTH_TOKEN=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=180

# Local agentic chatbot. OpenAI is optional and disabled unless CHATBOT_LLM_PROVIDER=openai.
CHATBOT_LLM_PROVIDER=local
CHATBOT_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_LLM_TIMEOUT_SECONDS=20
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini is optional and disabled by default. Never commit a real key.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=8
GEMINI_MAX_RETRIES=1
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_ROLLOUT_PERCENT=100
GEMINI_FALLBACK_ENABLED=false
GEMINI_FAIL_CLOSED=false

CHATBOT_RESPONSE_CACHE_TTL_SECONDS=0
CHATBOT_OPENAI_REQUESTS_PER_MINUTE=20
CHATBOT_TOOL_CALLS_PER_MINUTE=120
CHATBOT_AUDIT_ENABLED=true

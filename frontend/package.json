{
  "name": "payment-observability-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --configLoader runner",
    "build": "tsc && vite build --configLoader runner",
    "typecheck": "tsc --noEmit --incremental false",
    "test:sync": "node --experimental-strip-types tests/dashboardSync.test.ts",
    "test:visual": "node --experimental-strip-types tests/visualInterpolation.test.ts",
    "test:chat": "node --experimental-strip-types tests/chatApi.test.ts",
    "test:redis": "node --experimental-strip-types tests/redisStatus.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.4.3"
  }
}
